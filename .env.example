DATABASE_URL="mysql://cobblemart_user:replace-me@127.0.0.1:3306/cobbleshop"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# New orders use Stripe-hosted Checkout with PromptPay QR in THB only.
PAYMENT_PROVIDER="stripe"
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
DEFAULT_CURRENCY="THB"

# dry-run | webhook | rcon (shown read-only in Admin Settings)
DELIVERY_MODE="dry-run"
RCON_HOST="127.0.0.1"
RCON_PORT="25575"
RCON_PASSWORD="replace-with-a-long-random-password"
RCON_TIMEOUT_MS="5000"
DELIVERY_CRON_SECRET="replace-with-another-long-random-secret"
